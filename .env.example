# =====================================================================
#  TavDex – configuração (segredos)
#  Copiar este ficheiro para ".env" e preencher os valores.
#  O ".env" NUNCA vai para o GitHub (está no .gitignore).
# =====================================================================

# Porta onde o site abre: http://localhost:3000
PORTA=3000

# Endereço público do site (usado nos links dos emails e no login com Google)
URL_SITE=http://localhost:3000

# Base de dados MySQL
BD_HOST=localhost
BD_PORTA=3306
BD_UTILIZADOR=root
BD_PASSWORD=
BD_NOME=TavDex

# Segredo que assina o cookie da sessão (escrever uma frase longa e aleatória)
SEGREDO_SESSAO=muda-isto-para-uma-frase-longa-e-aleatoria

# Login com Google (Fase 2) – criar em https://console.cloud.google.com
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails com o Gmail (Fase 2) – usar uma "palavra-passe de aplicação" da conta Google
GMAIL_UTILIZADOR=
GMAIL_PASSWORD_APP=
