# =====================================================================
#  TavDex – configuração (segredos)
#  Copiar este ficheiro para ".env" e preencher os valores.
#  O ".env" NUNCA vai para o GitHub (está no .gitignore).
#  Num alojamento (Render, Railway, ...) estas variáveis põem-se no painel
#  "Environment" do serviço, e não num ficheiro.
#  Valores sem aspas e sem espaços à volta do "=".
# =====================================================================

# Porta onde o site abre: http://localhost:3000
PORTA=3000

# Endereço público do site, sem "/" no fim (usado nos links dos emails e no Google).
# Se começar por https, o servidor obriga a https, liga o HSTS e os cookies ficam "secure".
URL_SITE=http://localhost:3000

# Base de dados MySQL
BD_HOST=localhost
BD_PORTA=3306
BD_UTILIZADOR=root
BD_PASSWORD=
BD_NOME=TavDex

# Segredo que assina o cookie da sessão (frase longa e aleatória). Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGREDO_SESSAO=muda-isto-para-uma-frase-longa-e-aleatoria

# Login com o Google – criar em https://console.cloud.google.com (ver LEIA-ME.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tem de ser EXATAMENTE igual ao URI registado na Google (senão dá redirect_uri_mismatch).
# Se ficar vazio, usa URL_SITE + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Emails (recuperação da palavra-passe, avisos, notificações)
#   smtp      envia a sério pelo Gmail (precisa das duas linhas de baixo)
#   ficheiro  guarda cada email na pasta emails/ (para testar)
#   consola   escreve o email na consola do servidor
# Vazio: smtp se o Gmail estiver preenchido, senão consola.
EMAIL_MODE=
# Conta Gmail e "palavra-passe de aplicação" (não é a palavra-passe normal do Gmail)
GMAIL_UTILIZADOR=
GMAIL_PASSWORD_APP=
# Remetente que aparece nos emails (opcional), ex.: TavDex <o.teu.email@gmail.com>
EMAIL_FROM=

# Segurança das contas (1 = ligado, 0 = desligado)
# Verificar se a palavra-passe nova apareceu em fugas de dados (Have I Been Pwned,
# com k-anonimidade: só os 5 primeiros caracteres do SHA-1 saem do servidor).
# Se a internet falhar, a palavra-passe é aceite na mesma.
VERIFICAR_FUGAS=1
# Verificar se o domínio do email existe e recebe emails (registos MX no DNS).
# Se o DNS falhar, o email é aceite na mesma (a confirmação por email é a prova final).
VERIFICAR_DNS=1
# Armadilha de tempo do registo: segundos mínimos entre abrir a página e criar a conta
# (os robôs enviam o formulário logo). 0 desliga.
TEMPO_MINIMO_REGISTO=3
